# Inner Datum — npm behaviour. Committed on purpose: these are supply-chain
# controls, not personal preference, and they must apply to every clone.
# min-release-age needs npm >= 11.10 (Node 24.12+ ships it; D6 records 11.17.0).

# Quarantine. Refuse to RESOLVE any version published less than 7 days ago.
# Most malicious npm releases are detected and unpublished within days, so this
# makes the attacker's window a week rather than an hour. It is a RESOLUTION
# control only — `npm ci` against the committed lockfile is unaffected, which is
# why CI sets NPM_CONFIG_MIN_RELEASE_AGE=0 to avoid a confusing no-op warning.
# Genuine emergency escape hatch: npm i --min-release-age=0 <pkg>@<ver>
min-release-age=7

# The plan says "pin versions at install time and record them". This is that
# rule, enforced: `npm i <pkg>` writes an exact version, not a caret range.
save-exact=true

# Refuse to install under a Node version the server cannot run on. Pairs with
# "engines" in package.json. Turns a baffling type-stripping failure three hours
# later into a clear refusal now.
engine-strict=true

fund=false

# DELIBERATELY NOT SET: ignore-scripts. It is a genuinely good control, but Vite
# and Vitest pull esbuild, whose binary resolution is the one thing in this
# dependency set that install scripts touch. If you turn it on, do it as its own
# commit, run a clean `rm -rf node_modules && npm ci && npx vite build` to prove
# the client still builds, and record the result as a decision entry. Hardening
# that breaks the build on a Saturday gets reverted at 1am, after which this
# file says something nobody believes.
