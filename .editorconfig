# Inner Datum — editor defaults. Read automatically by VS Code, JetBrains and
# Vim/Neovim (with the plugin), and by Prettier.
#
# This file agrees with the Prettier config by construction; where they overlap,
# Prettier wins because it is the one that runs in CI. Keep it short — its only
# job is to make an editor that has never seen this repo behave correctly before
# the first save.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Two trailing spaces is a hard line break in Markdown, and the docs use them.
[*.md]
trim_trailing_whitespace = false

# Windows script hosts genuinely need CRLF.
[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf
indent_size = 4

# Verbatim upstream documents, wrapped at 80 by their authors.
[{LICENSE,COPYING,NOTICE,COPYING-*}]
max_line_length = 80
trim_trailing_whitespace = false
