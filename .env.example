# ---------------------------------------------------------------------------
# Inner Datum — environment template. Copy to.env and fill in:
#     cp.env.example.env                        (PowerShell: Copy-Item)
#
#.env is gitignored. Never commit it, never paste it into an issue, never
# screenshot a terminal that has it open. Node reads it natively —
#     node --env-file=.env src/server/main.ts
# — there is no dotenv dependency.
#
# Values marked SECRET are credentials. If one leaks: ROTATE FIRST, then clean
# history. Rewriting history alone does not undo a leak. See SECURITY.md.
# ---------------------------------------------------------------------------


# === Discord application ====================================================
# Developer Portal -> your app. Keep the app PERSONAL, not a Team: everyone on
# a Developer Team can read the client secret and reset the bot token
#. Add friends as App Testers instead (§ 7).

# Public identifier for the Activity. Not a secret — it is visible in every
# client URL (https://<CLIENT_ID>.discordsays.com). Portal -> OAuth2 -> Client ID.
DISCORD_CLIENT_ID=000000000000000000

# SECRET. Proves this server is the app during the OAuth code exchange.
# Anyone holding it can mint access tokens as your Activity.
# Rotate: Portal -> OAuth2 -> Reset Secret (takes effect immediately).
DISCORD_CLIENT_SECRET=

# SECRET. Bot credential, used server-side only, to verify that a connecting
# user really is a participant in the Activity instance
# (GET /applications/{app}/activity-instances/{id}).
# Keep "Public Bot" OFF and never invite this bot to a server.
# Rotate: Portal -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=


# === Session signing ========================================================

# SECRET. HMAC key for the short-lived session token bound to
# {userId, instanceId} and presented on the WebSocket handshake
#. Without it the WS handshake is
# forgeable by anyone who can reach the origin.
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it logs everyone out and costs nothing else — do it freely.
SESSION_SECRET=

# Session token lifetime in seconds. Long enough to survive a client reload,
# short enough that a copied token is worthless by the time it is noticed.
SESSION_TTL_SECONDS=900


# === Who is allowed in ======================================================

# Comma-separated Discord user snowflakes permitted to connect at all.
# PERSONAL DATA: these are your friends' account IDs. They live here, in a
# gitignored file, rather than in a committed config/allowlist.json.
ALLOWED_USER_IDS=

# Comma-separated subset of the above permitted to run GM commands over the
# socket. Checked against the server-verified snowflake from /users/@me, never
# against anything the client sent.
GM_USER_IDS=

# Set to 1 to enable the process.stdin GM REPL. Only ever on the host box you
# personally sit at — it is an unauthenticated console by construction.
ENABLE_STDIN_GM=


# === Server =================================================================

# Bind address. Keep 127.0.0.1. Caddy (or the tunnel) connects from localhost,
# so the game stays unreachable from your LAN and from the open internet even
# if a firewall rule is misconfigured.
HOST=127.0.0.1
PORT=3000

# production | development. development enables the DiscordSDKMock path and
# verbose error bodies. Never run production with development error output —
# stack traces name your filesystem paths.
NODE_ENV=development

# Where saves live. Use an absolute path in production: the Windows service
# runs with a different working directory.
# Contains Discord user IDs. Gitignored, and excluded from any public backup.
DATA_DIR=./data

# Authored game content (JSON). Committed to the repo; override only for
# experiments against an alternate content set.
CONTENT_DIR=./content

# pino level: fatal | error | warn | info | debug | trace.
# NEVER trace in production: it logs request bodies, and request bodies during
# auth contain OAuth codes and the client secret. Configure pino `redact` for
# authorization / code / client_secret / access_token / refresh_token.
LOG_LEVEL=info


# === Ops control panel ==============================
# A SECOND listener, deliberately separate from the game app. It is never
# routed through Caddy, has no Discord URL Mapping, and must never be port
# forwarded. This repo is public: anyone can read its exact routes, so the
# only defence that survives is not being reachable.

OPS_PORT=3001

# Keep 127.0.0.1. If you genuinely want it from your phone on the LAN, set a
# specific LAN address (e.g. 192.168.1.50) — NEVER 0.0.0.0, and never add a
# router forward for this port.
OPS_BIND=127.0.0.1


# === Asset pipeline (tools/build-assets.mjs) ================================

# Absolute path to the Outer Index art source tree. That tree is NOT part of
# this repo, is NOT redistributable, and contributors will not have it —
# `npm run assets` failing for a contributor is expected and correct.
# The built output is committed, so the game runs from a plain clone.
# See CONTRIBUTING.md § Assets and the design notes.
ART_SOURCE_DIR=


# === Client build ===========================================================
# WARNING: Vite INLINES every VITE_-prefixed variable into the client bundle in
# plaintext, and that bundle is served to every player's browser. Never put a
# secret behind a VITE_ prefix. There is no exception to this.

VITE_DISCORD_CLIENT_ID=000000000000000000


# === Deployment — NOT read by the application ===============================
# Listed here so the secret inventory is complete in one place. In practice
# these are consumed by Caddy, cloudflared, the No-IP DUC and your backup job,
# and are stored outside this repo (Windows service configuration / registry).
#
# Primary hosting path is free No-IP hostname + Caddy + port-forward TCP 443
#. Cloudflare Tunnel is the documented fallback.

# The public hostname players' browsers reach, via the Discord URL Mapping.
# Not a secret, but do NOT put it in the GitHub repo's Website field — it
# fronts a PC in your house.
# PUBLIC_HOSTNAME=play.example.ddns.net

# SECRET. No-IP Dynamic Update Client credentials (primary path). Also: the
# free hostname expires every 30 days unless confirmed. That silent expiry is
# the single likeliest cause of an outage — set a 3-week calendar reminder.
# NOIP_USERNAME=
# NOIP_PASSWORD=

# SECRET. Cloudflare Tunnel token (fallback path only).
# `cloudflared service install <TOKEN>`. A base64 blob containing your account
# tag, tunnel ID and tunnel secret. Anyone holding it can serve traffic on your
# hostname — i.e. serve anything they like to your friends, from your domain,
# over your TLS.
# NOTE: `service install` stores it in the service command line, where
# `sc qc cloudflared` prints it in full. Do not screenshot that command.
# Rotate: delete the tunnel in Zero Trust and create a new one.
# CLOUDFLARE_TUNNEL_TOKEN=

# SECRET. Deploy key or PAT for the private snapshot backup repo, if you use
# one. Must live outside the backup tree it pushes to.
# BACKUP_REPO_KEY=


# === Secrets NOT in this file, for completeness =============================
#  * %AppData%\Caddy\data\             — ACME account key + every issued
#                                        private key. Primary hosting path.
#  * ~/.cloudflared/<TUNNEL-ID>.json   — tunnel credentials, locally-managed
#  * ~/.cloudflared/cert.pem           — account-wide origin cert; creates
#                                        tunnels and DNS records on your zones.
#                                        The most dangerous file on the box.
#  * Player OAuth access tokens        — runtime, in memory, never persisted,
#                                        never logged
#  * Discord OAuth `code`              — arrives in a POST body; never log it
