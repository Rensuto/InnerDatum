{
  "name": "inner-datum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A co-op turn-based roguelike played inside a Discord voice channel, as a Discord Activity.",
  "license": "GPL-3.0-or-later",
  "author": "Dalton Barraclough",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:secrets": "node tools/check-secrets.mjs",
    "check:attribution": "node tools/check-attribution.mjs",
    "check:citations": "node tools/check-citations.mjs",
    "check:citation-names": "node tools/citation-names.mjs",
    "check:effects": "node tools/effect-reach.mjs",
    "check:inert": "node tools/inert.mjs --quiet",
    "check:constants": "node tools/check-constants.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:secrets && npm run check:assets && npm run check:attribution && npm run check:citations && npm run check:citation-names && npm run check:constants && npm run check:inert && npm run check:effects",
    "smoke": "node tools/smoke.mjs",
    "verify": "node tools/verify.mjs",
    "e2e": "node tools/e2e-m1.mjs",
    "dev": "node --watch --env-file=.env src/server/main.ts",
    "start": "node --env-file=.env src/server/main.ts",
    "build:client": "vite build",
    "assets": "python tools/gen_ui_assets.py && python tools/gen_content_assets.py && python tools/build_asset_manifest.py",
    "prepare": "node tools/install-hooks.mjs",
    "assets:derive": "python tools/derive_assets.py",
    "assets:all": "npm run assets:derive && npm run assets",
    "check:assets": "node tools/check-assets.mjs",
    "check:committed": "node tools/check-committed.mjs",
    "updates": "node tools/updates.mjs",
    "updates:catchup": "node tools/updates.mjs --catchup",
    "art:needs": "node tools/art-needs.mjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  }
}
