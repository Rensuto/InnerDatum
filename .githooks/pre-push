#!/bin/sh
# Inner Datum — pre-push gate.
#
# Installed automatically: package.json's "prepare" script points
# core.hooksPath at.githooks/, so `npm install` on a fresh clone wires this up
# and nobody has to remember. No husky, no lint-staged, no extra dependencies
# in a public repo.
#
# Pre-PUSH, not pre-commit, on purpose. You commit dozens of times a weekend and
# push a handful; committing work-in-progress must stay instant, but nothing
# should reach the public repo without passing the same command CI runs.
# A hook slow enough to be annoying is a hook that gets --no-verify'd, after
# which it protects nothing while everyone still believes it runs.
#
# `git push --no-verify` stays available and that is CORRECT: the hotfix path
# during a live session must never be blocked. CI is the authority; this is
# only lower latency — it catches the mistake while it is still free to fix.

set -e

# ---------------------------------------------------------------------------
# THIS GATE IS ABOUT THE COMMIT, NOT THE DESK IT WAS WRITTEN ON
# ---------------------------------------------------------------------------
# `npm run check` reads the WORKING TREE. For most of this repo's life that was
# the same thing as the commit being pushed, so the distinction never mattered.
#
# It matters here, because work happens in this repo while a push is happening:
# a long-running build edits files for an hour, and pushing an ALREADY VERIFIED
# commit in the middle of that fails on half-finished code that is not being
# pushed and may never be committed. The observed case was a lint error in a
# switch statement in a file the push did not touch — correct, load-bearing, and
# completely irrelevant to what was going out.
#
# So: if the tree is dirty, say so plainly and check the tree anyway (it is a
# superset — anything wrong with the commit is also wrong here), but on FAILURE
# tell the truth about what was measured. A gate that blocks a good push and
# will not say why is a gate people learn to bypass, and once bypassed it
# protects nothing while everyone still believes it runs.
DIRTY=""
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then DIRTY="yes"; fi

if [ -n "$DIRTY" ]; then
	echo "pre-push: npm run check  (working tree is DIRTY — see below if this fails)"
else
	echo "pre-push: npm run check"
fi

# Whatever happens, explain the dirty case rather than leaving a wall of lint
# output to be interpreted. `trap` fires on the `set -e` exit too.
on_fail() {
	status=$?
	if [ "$status" -ne 0 ] && [ -n "$DIRTY" ]; then
		echo "" >&2
		echo "pre-push: the check ran against your WORKING TREE, which has uncommitted" >&2
		echo "          changes. The failure above may be in work you are NOT pushing." >&2
		echo "" >&2
		echo "          To see whether the commit itself is sound:" >&2
		echo "            git stash --include-untracked && npm run check && git stash pop" >&2
		echo "" >&2
		echo "          If it is, push it:  git push --no-verify" >&2
		echo "          CI runs this same command on the pushed commit regardless." >&2
	fi
	exit $status
}
trap on_fail EXIT

# ---------------------------------------------------------------------------
# WHY THIS IS NOT SIMPLY `npm run check`
# ---------------------------------------------------------------------------
# On Windows, Node ships THREE npm entry points side by side:
#
#     npm        <- a BASH script, `#!/usr/bin/env bash`
#     npm.cmd    <- a batch file, needs no shell at all
#     npm.ps1
#
# Git runs hooks under its own POSIX shell, and a POSIX shell's PATH lookup
# finds the extensionless `npm` first — the bash one. That is fine in Git Bash,
# which has bash. It is NOT fine in GitHub Desktop, which bundles a stripped
# git environment with no bash on PATH, so the hook starts, prints the line
# above, and then dies with:
#
#     /usr/bin/env: 'bash': No such file or directory
#
# That message names neither npm nor this hook, appears only in a GUI push
# dialog, and reads like a corrupt repository. It cost a real debugging session.
#
# So: prefer npm.cmd where it exists, which is exactly the Windows case, and
# which also skips a pointless bash wrapper on the way to the same npm. Falls
# through to plain `npm` on macOS and Linux, where npm.cmd does not exist.
#
# Located by FILE TEST, not by `command -v npm.cmd`. That lookup returns "not
# found" under MinGit even when the file is right there and runs perfectly by
# absolute path — MSYS does not treat .cmd as executable for PATH resolution.
# `node` resolves fine (it is a real .exe), and npm.cmd always ships beside it,
# including under nvm-windows and Volta.
#
# Builtins only below. MinGit has no coreutils: `ls`, `grep` and even `dirname`
# are absent, so the directory is taken with ${VAR%/*} parameter expansion
# rather than by calling out to anything.
NODE_BIN="$(command -v node 2>/dev/null || true)"

if [ -n "$NODE_BIN" ] && [ -f "${NODE_BIN%/*}/npm.cmd" ]; then
	"${NODE_BIN%/*}/npm.cmd" run check
elif command -v npm >/dev/null 2>&1; then
	npm run check
else
	# Never fail silently or cryptically: a hook that blocks a push must say
	# why, and say what to do about it.
	echo "pre-push: npm is not on PATH, so the check gate cannot run." >&2
	echo "          Install Node 24.12+, or push with --no-verify if you have" >&2
	echo "          already run 'npm run check' yourself." >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# DRAIN THE ANNOUNCEMENT BACKLOG — the safety net under the post-commit hook
# ---------------------------------------------------------------------------
# Every commit in this project is announced to #updates. The post-commit hook
# does that at commit time, and it CANNOT be relied on alone: it is deliberately
# fail-soft (losing an announcement is a nuisance, losing a commit is a
# disaster), so a commit made offline, on a laptop with no token, or while
# Discord is down posts nothing and says so and then life moves on. Left there,
# the channel quietly develops a hole — and a silent week is indistinguishable
# from a dead relay, which is the failure this project has already had once.
#
# So the backlog is drained HERE, at the last moment before the work becomes
# public, for the same reason check-assets runs in the gate rather than only in
# .gitignore. `catchup` is idempotent against a per-sha ledger in .git/, so
# running it on every push cannot double-post.
#
# IT CANNOT BLOCK A PUSH. `--soft` keeps the relay at exit 0 on any failure, and
# the `|| true` covers a crash in the relay itself. A hotfix during a live
# session must never wait on Discord being up.
RELAY="c:/Users/dalto/Desktop/Files/VSCode Projects/_shared/discord-relay/relay.mjs"
if [ -n "$NODE_BIN" ] && [ -f "$RELAY" ]; then
	echo "pre-push: draining the #updates backlog"
	"$NODE_BIN" "$RELAY" catchup --repo "$(git rev-parse --show-toplevel)" --soft || true
fi
